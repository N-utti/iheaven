---
import Base from '../layouts/Base.astro';
import { TEL, BOOKING } from '../site.js';

// 내용은 모두 옛 사이트 루세떼·루세떼 장례서비스·장례비용 페이지 원문에서 옮김
const patent = [
  '순수 100% 반려동물 유골분으로 제작됩니다.',
  '루세떼 공정 시 유골의 손실이 없습니다.',
  '영구보존이 목적이며 변질되지 않습니다.',
  '순수 100% 유골분의 원 상태로 복구(리스토어 서비스)가 가능합니다.',
];

const kinds = [
  ['무빙 루세떼', 'lucete-moving.jpg', '커팅이 들어간 루세떼 1-3개가 목걸이 안쪽에서 움직이는 형태입니다. 다이아 커팅 감정서를 동봉해 드립니다.'],
  ['퀀텀 루세떼', 'lucete-quantum.jpg', '커팅, 연마 작업 없이 루세떼 1-2개를 작은 루세떼 90-110개로 변환한 사이즈로 제작해, 유골 손실이 없습니다.'],
];

// ponytail: 제품 코드와 사진 짝은 옛 갤러리에서 보고 고른 추정. 틀리면 photo 값만 바꾸면 됨
const jewelry = [
  { name: 'SIMPLEX JSB-01', photo: 'jewelry-03.jpg', price: '700,000원', items: ['커팅 디자인 선택 가능', '다이아 커팅 감정서 동봉', '반지 테두리 안쪽에 각인', '12호 이상 반지는 추가 금액 발생'] },
  { name: 'SIMPLEX JST-01', photo: 'jewelry-06.jpg', price: '700,000원', items: ['연마 작업 최소', '반지 테두리 안쪽에 각인', '12호 이상 반지는 추가 금액 발생'] },
  { name: 'SIMPLEX JST-02', photo: 'jewelry-10.jpg', price: '700,000원', items: ['연마 작업 최소', '펜던트 외곽에 각인', '42cm 체인 포함 (길이에 따라 추가 비용 발생)'] },
  { name: 'ORBIS JO-01', photo: 'jewelry-09.jpg', price: '실버 700,000원 · 골드 1,000,000원', items: ['루세떼 2-4개로 JO-01 전용 루세떼 제작', '펜던트 테두리에 각인', '체인 별도 구매'] },
  { name: 'ORBIS JOM-01', photo: 'jewelry-13.jpg', price: '실버 800,000원 · 골드 1,200,000원', items: ['무빙 루세떼 또는 퀀텀 루세떼 3개', '무빙 루세떼 사용 시 바닥면에 pawHeart 문구 각인', '체인 별도 구매'] },
  { name: 'ASTRO JTS-01', photo: 'jewelry-12.jpg', price: '900,000원', items: ['연마 작업 없이 제작', '각인 시 추가 비용 발생', '체인 별도 구매'] },
  { name: 'ASTRO JTM-01', photo: 'jewelry-07.jpg', price: '실버 800,000원 · 골드 1,000,000원', items: ['퀀텀 루세떼 작은 개체 1-200개로 제작 (연마 없음)', '체인 별도 구매'] },
  { name: 'CROSS JCM-01', photo: 'jewelry-cross.jpg', price: '실버 1,300,000원 · 골드 1,600,000원', items: ['무빙 루세떼 또는 퀀텀 루세떼 3개', '십자가 바닥면에 각인', '체인 별도 구매'] },
];

const heroPhotos = [
  ['lucete.jpg', '원목 함에 담긴 초록빛 루세떼 스톤과 강아지 조각'],
  ['lucete-hero-2.jpg', '원목 함 가득 담긴 루세떼 스톤과 유리구'],
  ['lucete-hero-3.jpg', '아크릴 큐브 위의 루세떼 스톤과 이름이 새겨진 원목 함'],
  ['lucete-hero-4.jpg', '흰 꽃과 석고상 옆에 모아 놓은 루세떼 스톤'],
];

const stones = [
  ['stone-1.jpg', '조약돌 위에 올린 초록 루세떼 스톤'],
  ['stone-2.jpg', '레이스 위에 흩어진 루세떼 스톤'],
  ['stone-3.jpg', '새틴 천 위의 루세떼 스톤'],
  ['stone-4.jpg', '모래 위의 유골 조각과 나무 틀, 그 곁에 놓인 루세떼 스톤'],
  ['stone-5.jpg', '아크릴 큐브에 놓인 루세떼 스톤'],
  ['stone-6.jpg', '흰 꽃과 함께 놓인 루세떼 스톤'],
];

const plans = [
  { name: '루세떼 제작', price: '600,000', items: ['루세떼 제작', '유리 봉안함'] },
  { name: '루세떼 장례', price: '800,000', items: ['헤븐 장례 서비스', '루세떼 제작', '유리 봉안함'] },
  { name: '루세떼 고급 장례', price: '1,000,000', items: ['헤븐 고급 장례 서비스', '루세떼 제작', '유리 봉안함'] },
  { name: '루세떼 최고급 장례', price: '1,400,000', items: ['헤븐 최고급 장례 서비스 (무지개 유골함, 헤븐 하우스 제외)', '최고급 호두나무 루세떼함', '루세떼 제작'] },
];
---
<Base title="루세떼 | 아이헤븐" description="반려동물 유골분으로 만드는 순도 99.99%의 유골 보석, 루세떼. 특허(제10-1124873호) 공정으로 유골 손실 없이 제작합니다.">
  <section class="section intro">
    <div class="intro-inner">
      <div class="intro-copy">
        <p class="badge">특허 제10-1124873호</p>
        <h1>추억을 담은 영원한 빛, <br />루세떼</h1>
        <p>LUCETE는 스페인어로 "밝게 빛나라"라는 뜻입니다. 반려동물 유골분으로 만드는 순도 99.99%의 유골 보석화 서비스입니다.</p>
        <p>단순한 스톤이 아닌 강도와 투명도를 갖춘 아름다운 보석으로, 전문가의 세공을 거쳐 반지와 목걸이에 담아 영원히 함께하실 수 있습니다.</p>
        <div class="intro-cta">
          <a class="btn btn--gold" href={`tel:${TEL}`}>루세떼 상담 {TEL}</a>
          <a class="intro-link" href="#price">비용 보기</a>
        </div>
      </div>
      <!-- 슬라이더 동작은 Base.astro. 자동 5초 넘김, 드래그·스와이프 -->
      <div class="intro-photo">
        {heroPhotos.map(([src, alt], i) => <img src={`images/${src}`} alt={alt} draggable="false" loading={i ? 'lazy' : 'eager'} />)}
      </div>
      <a class="hero-scroll" href="#patent" aria-label="아래로 스크롤"><span>SCROLL</span><i aria-hidden="true"></i></a>
    </div>
  </section>

  <section class="section" id="patent">
    <div class="wrap patent">
      <img class="patent-photo" src="images/lucete-process.jpg" alt="유리 벽 너머로 제작 장비가 보이는 루세떼 별관 내부" loading="lazy" />
      <div class="patent-copy">
        <p class="eyebrow">LUCETE PATENT</p>
        <h2>루세떼 특허 공정방식</h2>
        <p>아이헤븐 루세떼의 공정방식은 특허청(제10-1124873호)에 등록되어 제작 방식의 안정성이 입증되었습니다.</p>
        <ul>{patent.map((t) => <li>{t}</li>)}</ul>
        <!-- 옛 사이트 특허증 사진 원본이 490px 라 작게 -->
        <img class="patent-cert" src="images/lucete-patent.jpg" alt="특허청 특허증 제10-1124873호" width="490" height="342" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">루세떼 종류</p>
        <h2>무빙 루세떼와 퀀텀 루세떼</h2>
      </div>
      <div class="swipe kinds">
        {kinds.map(([title, photo, text]) => (
          <article>
            <img class="kind-photo" src={`images/${photo}`} alt={`${title} 주얼리`} loading="lazy" />
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">루세떼 스톤</p>
        <h2>아이의 빛을 담은 작은 보석</h2>
        <p>유골분으로 만든 루세떼는 하나하나 색과 투명도가 조금씩 다릅니다. 그대로 간직하셔도, 주얼리에 담으셔도 됩니다.</p>
      </div>
      <ul class="swipe stones">
        {stones.map(([src, alt]) => <li><img src={`images/${src}`} alt={alt} loading="lazy" /></li>)}
      </ul>
    </div>
  </section>

  <section class="section soft">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">루세떼 주얼리</p>
        <h2>반지와 목걸이로, 언제나 함께</h2>
        <p>골드는 14K 옐로골드, 화이트골드, 로즈골드 중에서 고르실 수 있습니다.</p>
      </div>
      <ul class="jewelry">
        {jewelry.map((j) => (
          <li>
            <img class="jewelry-photo" src={`images/${j.photo}`} alt={`${j.name} 주얼리`} loading="lazy" />
            <h3>{j.name}</h3>
            <p class="jewelry-price">{j.price.split(' · ').map((t) => <span>{t}</span>)}</p>
            <ul>{j.items.map((it) => <li>{it}</li>)}</ul>
            <!-- 모바일에서 설명이 3줄 넘으면 접힘. 넘치지 않는 카드의 버튼은 아래 script 가 숨김 -->
            <button class="jewelry-more" type="button" aria-expanded="false" onclick="const c = this.closest('.jewelry > li'); c.classList.toggle('is-open'); this.setAttribute('aria-expanded', c.classList.contains('is-open'))"><span>더 보기</span><span>접기</span></button>
          </li>
        ))}
      </ul>
      <p class="note">체인 비용: 실버 70,000원 · 골드 230,000원</p>
    </div>
  </section>

  <section class="section" id="price">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">루세떼 비용</p>
        <h2>장례와 함께, 또는 제작만</h2>
        <p>자택 또는 다른 곳에 안치 중인 유골분도 변질 걱정 없이 보존하실 수 있도록 루세떼로 제작해 드립니다.</p>
      </div>
      <div class="plan-grid plans">
        {plans.map((p) => (
          <div class="plan">
            <h3>{p.name}</h3>
            <p class="plan-price"><strong>{p.price}</strong>원</p>
            <ul>{p.items.map((it) => <li>{it}</li>)}</ul>
          </div>
        ))}
      </div>
      <p class="note">모든 장례비용은 체중 5kg 이하 기준이며, 모든 금액은 부가세 별도입니다. 헤븐 장례 구성은 <a class="text-link" href="./#price">장례비용</a>에서 확인하실 수 있습니다.</p>
    </div>
  </section>

  <section class="section intro closing">
    <div class="wrap closing-inner">
      <h2>루세떼 상담</h2>
      <p>루세떼 제작과 장례 예약은 24시간 상담해 드립니다.</p>
      <div class="intro-cta">
        <a class="btn btn--gold" href={`tel:${TEL}`}>24시 상담 {TEL}</a>
        <a class="btn btn--light" href={BOOKING} target="_blank" rel="noopener">예약하기</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // 모바일에서 설명이 3줄 안에 다 들어가는 카드는 더 보기 버튼을 숨김 (CSS 만으론 넘침을 알 수 없어서)
  document.querySelectorAll<HTMLButtonElement>('.jewelry-more').forEach((b) => {
    const ul = b.previousElementSibling as HTMLElement;
    if (ul.scrollHeight <= ul.clientHeight + 1) b.hidden = true;
  });
</script>

<style>
  /* 인트로 공통 꼴·슬라이더는 Base.astro. 여기선 메인 카드와 잇는 전환 이름만 */
  .intro-photo { view-transition-name: lucete-photo; }
  .intro-photo img { object-position: 35% center; }

  .patent { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 88px); align-items: center; }
  .patent-photo { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .patent-copy { display: grid; gap: 16px; }
  .patent-cert { width: min(100%, 420px); height: auto; margin-top: 12px; border: 1px solid var(--line); }
  .patent h2 { font-size: clamp(24px, 2.6vw, 32px); }
  .patent ul { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 10px; color: var(--ink); }
  .patent li { padding-left: 26px; text-indent: -26px; }
  .patent li::before, .jewelry li li::before { content: '✓'; color: var(--gold-deep); font-weight: 700; display: inline-block; width: 26px; text-indent: 0; }

  .stones { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .stones img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }

  .kinds { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .kinds article { display: grid; gap: 10px; align-content: start; }
  .kind-photo { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; margin-bottom: 10px; }
  .kinds h3 { font-size: 18px; }
  .kinds p { font-size: 15px; }

  .jewelry { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px 20px; }
  /* subgrid: 같은 줄 카드끼리 사진·이름·가격·설명·더 보기 행 높이를 공유해 가격이 두 줄이어도 아래가 나란히 */
  .jewelry > li { display: grid; grid-template-rows: subgrid; grid-row: span 5; row-gap: 6px; }
  .jewelry-photo { width: 100%; aspect-ratio: 1; object-fit: cover; margin-bottom: 10px; }
  .jewelry h3 { font-size: 17px; letter-spacing: .02em; }
  .jewelry-price { color: var(--gold-deep); font-weight: 600; }
  .jewelry-price span + span::before { content: ' · '; }
  .jewelry-more { display: none; }
  .jewelry ul { list-style: none; margin: 6px 0 0; padding: 10px 0 0; border-top: 1px solid var(--line); display: grid; gap: 4px; font-size: 14px; }
  .jewelry li li { padding-left: 20px; text-indent: -20px; }
  .jewelry li li::before { width: 20px; }

  .plans { grid-template-columns: repeat(4, 1fr); }
  .plans .plan { padding: 32px 24px; }

  @media (max-width: 1080px) {
    .jewelry, .plans, .stones { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 860px) {
    /* 특허 섹션이 한 화면에 들어가게 사진은 빼고(히어로에 이미 사진) 특허증만 작게 */
    .patent { grid-template-columns: 1fr; gap: 20px; }
    .patent-photo { display: none; }
    .patent-cert { width: 150px; }
    .kinds { grid-template-columns: 1fr; }
    .jewelry { gap: 28px 14px; }
    /* 실버·골드 가격을 두 줄로 */
    .jewelry-price span { display: block; }
    .jewelry-price span + span::before { content: none; }
    /* 설명은 3줄까지, 나머지는 더 보기로 */
    .jewelry > li:not(.is-open) > ul { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
    .jewelry-more { display: block; justify-self: start; padding: 0; border: 0; background: none; font: inherit; font-size: 14px; color: var(--gold-deep); border-bottom: 1px solid currentColor; cursor: pointer; }
    .jewelry-more span:last-child, .jewelry > li.is-open .jewelry-more span:first-child { display: none; }
    .jewelry > li.is-open .jewelry-more span:last-child { display: inline; }
    .jewelry-more[hidden] { display: none; }
  }
  /* 낮은 화면(아이폰 SE 등)에선 비용 섹션의 설명 문장을 접어 카드까지 한 화면에 */
  @media (max-width: 860px) and (max-height: 700px) {
    #price .section-head p { display: none; }
  }
</style>
