---
import Base from '../layouts/Base.astro';
import { TEL, BOOKING, ADDRESS } from '../site.js';

// 답은 메인·장례서비스·루세떼·헤븐 하우스 화면에 이미 있는 사실만. 가격·시간을 바꾸면 여기와 public/llms.txt 도 같이
const faqs = [
  ['김해 반려동물 장례식장 아이헤븐은 어디에 있나요?', `아이헤븐은 ${ADDRESS}(지번 생림면 봉림리 872-1)에 있습니다. 마현 버스정류장(무척산 입구 방면)에서 걸어서 5분이며, 장애인 주차구역을 포함한 주차장이 있습니다.`],
  ['반려동물 장례 비용은 얼마인가요?', '체중 5kg 이하 기준으로 헤븐 장례 250,000원, 헤븐 고급 장례 450,000원, 헤븐 최고급 장례 1,000,000원입니다. 모든 금액은 부가세 별도입니다. 헤븐 장례에는 염습, 단독 추모실, 종교용품, 국화 헌화(생화), 개별화장, 기본 청자 유골함이 포함됩니다.'],
  ['장례 예약은 어떻게 하나요?', `24시간 ${TEL}로 전화하시거나 네이버 예약으로 예약하실 수 있습니다. 아이헤븐은 100% 예약제로 운영되어 다른 가족과 겹치지 않는 단독 추모 시간을 드립니다.`],
  ['운영 시간은 어떻게 되나요?', '운영 시간은 매일 오전 9시부터 오후 10시까지이며, 장례 예약 전화는 24시간 받습니다. 납골당 헤븐 하우스는 오전 9시부터 오후 6시까지 연중무휴로 방문하실 수 있습니다.'],
  ['개별화장인가요? 화장 과정을 직접 볼 수 있나요?', '아이헤븐은 개별화장과 보호자 참관을 원칙으로 합니다. 담당 장례지도사가 1:1로 배정되어 모든 과정을 보호자가 직접 지켜보실 수 있습니다.'],
  ['반려동물이 집에서 떠났을 때 무엇부터 해야 하나요?', '두툼한 수건으로 머리를 높게 받치고 몸 아래에 배변 패드나 큰 수건을 깔아 주세요. 목욕 대신 오염된 부위만 물수건으로 닦고, 더운 날에는 수건으로 감싼 아이스팩을 배나 등 쪽에 놓아 주세요. 서두르지 않으셔도 됩니다.'],
  ['직접 데려가기 어려우면 어떻게 하나요?', `담요나 큰 수건으로 감싸 안거나 상자에 넣어 흔들리지 않게 이동해 주세요. 직접 이동이 어렵다면 ${TEL}로 비대면 픽업 가능 여부를 문의해 주세요.`],
  ['루세떼는 무엇인가요?', '루세떼는 반려동물 유골분으로 만드는 순도 99.99%의 유골 보석입니다. 특허(제10-1124873호) 공정으로 제작하며 반지와 목걸이로 만들 수 있습니다. 루세떼 제작만 600,000원, 루세떼 장례는 800,000원부터입니다.'],
  ['납골당 헤븐 하우스 비용은 얼마인가요?', '헤븐 하우스 안치는 1년 약정 기준 200,000원부터이며 부가세 별도입니다. 자택이나 다른 곳에 안치 중인 봉안함도 아이헤븐에서 이함한 뒤 안치하실 수 있습니다.'],
  ['정식 허가를 받은 장례식장인가요?', '주식회사 아이헤븐은 동물장묘업 허가(제 5350000-038-2018-0001호)를 받은 반려동물 장례식장입니다. 허가증은 화면 아래 「허가증 보기」에서 확인하실 수 있습니다.'],
];
---
<Base title="자주 묻는 질문 | 김해 반려동물 장례식장 아이헤븐" description="김해 반려동물 장례식장 아이헤븐의 위치, 장례 비용, 예약 방법, 운영 시간, 개별화장과 보호자 참관, 루세떼, 납골당 헤븐 하우스에 대한 질문과 답입니다.">
  <article class="policy wrap">
    <h1>자주 묻는 질문</h1>
    {faqs.map(([q, a]) => (
      <>
        <h2>{q}</h2>
        <p>{a}</p>
      </>
    ))}
    <p class="faq-links"><a class="text-link" href="./#price">장례비용 자세히</a> · <a class="text-link" href="./#aftercare">사후 기초 수습 방법</a> · <a class="text-link" href={BOOKING} target="_blank" rel="noopener">네이버 예약</a> · <a class="text-link" href={`tel:${TEL}`}>전화 {TEL}</a></p>
  </article>
</Base>

<style>
  .policy { max-width: 760px; padding-block: 80px 120px; }
  .policy h1 { font-size: clamp(28px, 3vw, 36px); margin-bottom: 24px; }
  .policy h2 { font-size: 19px; margin: 40px 0 12px; }
  .faq-links { margin-top: 48px; }
</style>
