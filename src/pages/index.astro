---
import Base from '../layouts/Base.astro';
import { TEL, BOOKING, ADDRESS } from '../site.js';

const features = [
  { id: 'service', title: '1:1 장례지도사의 책임장례', photo: '장례지도사 · 염습 사진', text: '모든 장례 절차에 반려동물 장례지도사가 1:1로 배정되어, 보호자와 함께 마지막까지 정성껏 진행합니다. 개별화장과 보호자 참관으로 모든 과정을 직접 지켜보실 수 있습니다.', cta: ['장례비용 알아보기', '#price'] },
  { id: 'memorial', title: '100% 예약제, 여유로운 단독 추모', photo: '단독 추모실 사진', text: '예약제로 운영해 다른 가족과 겹치지 않는 단독 추모실에서, 서두르지 않고 충분히 작별 인사를 나누실 수 있습니다.', cta: ['네이버로 예약하기', BOOKING] },
  { id: 'lucete', title: '추억을 담은 영원한 빛, 루세떼', photo: '루세떼 스톤 · 주얼리 사진', text: '"밝게 빛나라"는 뜻의 루세떼. 아이의 유골분을 순도 99.99%의 보석으로 만들어, 반지와 목걸이로 언제나 곁에 두실 수 있습니다.', cta: ['루세떼 장례비용', '#price'] },
  { id: 'house', title: '언제든 만날 수 있는 안식처, 헤븐 하우스', photo: '헤븐 하우스(납골당) 사진', text: '쾌적하고 아늑한 공간에서 아이가 편히 쉴 수 있도록 모십니다. 오전 9시부터 오후 6시까지 연중무휴로 찾아오실 수 있습니다.', cta: ['오시는 길', '#location'] },
];

const plans = [
  { name: '헤븐 장례', price: '250,000', items: ['염습', '단독 추모실', '종교용품', '국화 헌화 (생화)', '개별화장', '기본 청자 유골함'] },
  { name: '헤븐 고급 장례', price: '450,000', items: ['헤븐 장례 구성 전체', '고급 수의', '고급 오동나무관', '청자 유골함'], featured: true },
  { name: '헤븐 최고급 장례', price: '1,000,000', items: ['헤븐 장례 구성 전체', '최고급 수의', '최고급 오동나무관', '무지개 유골함', '헤븐 하우스', '원목 액자'] },
];

// 기존 사이트 공지 「사후 기초수습 방법 안내」 원문을 글로 옮김
const aftercare = [
  ['자세를 잡고 패드를 깔아 주세요', '시간이 지나면 잔뇨·잔변 등 분비물이 나올 수 있습니다. 두툼한 수건으로 머리를 높게 받쳐 준 뒤, 몸 아래에 배변 패드나 큰 수건을 깔아 주세요.'],
  ['눈은 억지로 감기지 않아도 됩니다', '동물은 안구가 돌출되어 있어 눈을 뜨고 있는 것이 자연스럽습니다. 감겨 주더라도 다시 떠질 수 있으니, 어렵다면 그대로 두셔도 됩니다.'],
  ['혀가 나와 있다면 입 안으로', '사후 경직으로 입이 닫히면 혀가 다칠 수 있습니다. 혀를 입 안쪽으로 넣고 거즈나 솜을 두툼하게 물려 주세요.'],
  ['목욕 대신 부분 세정', '목욕은 2차 손상의 위험이 있어 권하지 않습니다. 오염된 부위만 세정 티슈나 물수건으로 닦아 주세요.'],
  ['더운 날에는 서늘하게', '날이 덥거나 장례를 늦게 치러야 한다면, 아이스팩을 수건으로 감싸 배나 등 쪽에 놓아 주세요.'],
  ['아이헤븐에 연락해 주세요', `24시간 ${TEL}로 연락 주시면 장례 예약을 자세히 안내해 드립니다.`],
  ['예약한 시간에 방문해 주세요', '담요나 큰 수건으로 감싸 안거나, 상자에 넣고 흔들리지 않게 빈 곳을 채워 이동해 주세요. 직접 이동이 어렵다면 비대면 픽업 가능 여부를 문의해 주세요.'],
];

const mapQuery = encodeURIComponent(ADDRESS);
---
<Base>
  <section class="hero">
    <div class="hero-media">
      <span class="hero-photo-label">대표 사진 · 시설 외관 또는 추모실</span>
      <div class="hero-copy">
        <p class="hero-brand">아이헤븐</p>
        <h1>가족이었던 아이의 <br />마지막 산책길을 함께합니다.</h1>
        <div class="hero-cta">
          <a class="btn btn--light" href={`tel:${TEL}`}>24시 장례상담 {TEL}</a>
          <a class="hero-link" href="#aftercare">아이가 방금 떠났다면 — 사후 수습 방법 →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="intro">
    <div class="wrap">
      <p class="intro-lead">김해 반려동물 장례식장 <strong>아이헤븐</strong>이 <br />진심 어린 위로로 아이의 마지막을 함께합니다.</p>
      <ul class="intro-facts">
        <li><strong>2018</strong>정식 등록 동물장묘업</li>
        <li><strong>1:1</strong>담당 장례지도사 배정</li>
        <li><strong>100%</strong>예약제 단독 추모</li>
      </ul>
    </div>
  </section>

  <section class="section features">
    <div class="wrap">
      {features.map((f, i) => (
        <article class:list={['feature', { 'feature--flip': i % 2 }]} id={f.id}>
          <div class="ph feature-photo">{f.photo}</div>
          <div class="feature-copy">
            <p class="eyebrow">– 아이헤븐은</p>
            <h2>{f.title}</h2>
            <p>{f.text}</p>
            <a class="btn" href={f.cta[1]} {...(f.cta[1].startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{f.cta[0]}</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section price" id="price">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">장례비용</p>
        <h2>장례비용을 투명하게 공개합니다</h2>
        <p>모든 금액은 체중 5kg 이하 기준이며 부가세 별도입니다.</p>
      </div>
      <div class="plan-grid">
        {plans.map((p) => (
          <div class:list={['plan', { 'plan--featured': p.featured }]}>
            <h3>{p.name}</h3>
            <p class="plan-price"><strong>{p.price}</strong>원</p>
            <ul>{p.items.map((it) => <li>{it}</li>)}</ul>
          </div>
        ))}
      </div>
      <p class="price-note">루세떼 장례 800,000원부터 · 루세떼 제작만 600,000원 · 납골당 안치 1년 200,000원부터</p>
    </div>
  </section>

  <section class="section aftercare" id="aftercare">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">사후 기초 수습 방법</p>
        <h2>아이가 떠났을 때, 이렇게 해 주세요</h2>
        <p>당황스러운 순간이지만 서두르지 않으셔도 됩니다. 집에서 할 수 있는 기본 수습 방법을 안내해 드립니다.</p>
      </div>
      <ol class="steps">
        {aftercare.map(([title, text], i) => (
          <li>
            <span class="step-num">{i + 1}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
      <div class="aftercare-note">
        <p>너무 급하게 장례를 치르지 마시고, 가족과 함께 충분한 애도의 시간을 보내시길 바랍니다. <br />이별이 상처가 아닌 소중한 기억이 되도록 아이헤븐이 돕겠습니다.</p>
        <a class="btn" href={`tel:${TEL}`}>24시 장례상담 {TEL}</a>
      </div>
    </div>
  </section>

  <section class="section location" id="location">
    <div class="wrap location-inner">
      <div class="ph map">지도 영역</div>
      <div>
        <p class="eyebrow">오시는 길</p>
        <h2>아이헤븐 오시는 길</h2>
        <dl class="info">
          <div><dt>주소</dt><dd>{ADDRESS}<br /><span>(지번) 생림면 봉림리 872-1</span></dd></div>
          <div><dt>대중교통</dt><dd>마현 버스정류장(무척산 입구 방면)에서 도보 5분</dd></div>
          <div><dt>장례 예약</dt><dd>24시간 · {TEL}</dd></div>
          <div><dt>운영 시간</dt><dd>오전 9시 – 오후 8시</dd></div>
          <div><dt>납골당 방문</dt><dd>오전 9시 – 오후 6시, 연중무휴</dd></div>
        </dl>
        <div class="map-links">
          <a class="btn btn--line" href={`https://map.naver.com/p/search/${mapQuery}`} target="_blank" rel="noopener">네이버 지도</a>
          <a class="btn btn--line" href={`https://map.kakao.com/?q=${mapQuery}`} target="_blank" rel="noopener">카카오맵</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 0 clamp(0px, 3vw, 44px); }
  .hero-media { position: relative; min-height: min(78vh, 760px); display: flex; align-items: flex-end; padding: clamp(32px, 6vw, 88px);
    background: linear-gradient(180deg, rgba(20,29,56,0) 30%, rgba(20,29,56,.55)), repeating-linear-gradient(135deg, #6f7a95 0 16px, #68738e 16px 32px); }
  .hero-photo-label { position: absolute; top: 24px; right: 28px; color: rgba(255,255,255,.7); font-size: 13px; letter-spacing: .04em; }
  .hero-copy { display: grid; gap: 20px; color: #fff; }
  .hero-brand { font-size: 18px; font-weight: 600; opacity: .9; }
  .hero h1 { color: #fff; font-size: clamp(30px, 4.4vw, 54px); font-weight: 600; letter-spacing: -.02em; }
  .hero-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 28px; margin-top: 8px; }
  .hero-link { font-size: 15px; color: rgba(255,255,255,.9); border-bottom: 1px solid rgba(255,255,255,.5); padding-bottom: 2px; }

  .intro { background: var(--navy); color: #c9cfe0; padding-block: 72px; }
  .intro .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 40px; }
  .intro-lead { font-size: clamp(20px, 2.2vw, 26px); line-height: 1.6; color: #fff; }
  .intro-lead strong { font-weight: 700; }
  .intro-facts { list-style: none; margin: 0; padding: 0; display: flex; gap: clamp(28px, 4vw, 64px); font-size: 14px; }
  .intro-facts strong { display: block; font-size: 30px; font-weight: 600; color: #fff; line-height: 1.3; }

  .features .wrap { display: grid; gap: clamp(64px, 9vw, 120px); }
  .feature { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 100px); align-items: center; }
  .feature--flip .feature-photo { order: 2; }
  .feature-photo { aspect-ratio: 16 / 10; }
  .feature-copy { display: grid; gap: 14px; justify-items: start; max-width: 460px; }
  .feature-copy h2 { font-size: clamp(24px, 2.5vw, 30px); color: var(--navy); }
  .feature-copy .btn { margin-top: 12px; }

  .price { background: var(--soft); }
  .plan-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .plan { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 36px 32px; display: grid; gap: 14px; align-content: start; }
  .plan--featured { border: 2px solid var(--navy); }
  .plan h3 { font-size: 19px; }
  .plan-price { color: var(--muted); }
  .plan-price strong { font-size: 34px; font-weight: 700; color: var(--navy); margin-right: 4px; }
  .plan ul { list-style: none; margin: 0; padding: 18px 0 0; border-top: 1px solid var(--line); display: grid; gap: 8px; font-size: 15px; }
  .plan li::before { content: '✓'; color: var(--navy); margin-right: 10px; font-weight: 700; }
  .price-note { margin-top: 28px; text-align: center; font-size: 15px; color: var(--muted); }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .steps li { border: 1px solid var(--line); border-radius: var(--radius); padding: 28px 24px; display: grid; gap: 10px; align-content: start; }
  .step-num { width: 32px; height: 32px; border-radius: 50%; background: var(--navy); color: #fff; display: grid; place-items: center; font-weight: 600; font-size: 15px; }
  .steps h3 { font-size: 17px; }
  .steps p { font-size: 15px; }
  .aftercare-note { margin-top: 40px; padding: 36px 40px; border-radius: var(--radius); background: var(--soft); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px; color: var(--ink); }

  .location { padding-top: 0; }
  .location-inner { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(40px, 6vw, 80px); align-items: center; }
  .location h2 { font-size: clamp(24px, 2.5vw, 30px); color: var(--navy); margin: 8px 0 28px; }
  .map { aspect-ratio: 4 / 3; }
  .info { margin: 0 0 32px; display: grid; gap: 14px; }
  .info div { display: grid; grid-template-columns: 100px 1fr; }
  .info dt { color: var(--muted); }
  .info dd { margin: 0; color: var(--ink); }
  .info dd span { color: var(--muted); font-size: 14px; }
  .map-links { display: flex; flex-wrap: wrap; gap: 10px; }

  @media (max-width: 1080px) {
    .steps { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 860px) {
    .hero { padding: 0; }
    .hero-media { min-height: 72vh; }
    .hero h1 br { display: none; }
    .intro-lead br { display: none; }
    .feature, .location-inner { grid-template-columns: 1fr; gap: 28px; }
    .feature--flip .feature-photo { order: 0; }
    .plan-grid, .steps { grid-template-columns: 1fr; }
    .aftercare-note { padding: 28px 24px; }
    .aftercare-note br { display: none; }
  }
</style>
