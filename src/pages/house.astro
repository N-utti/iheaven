---
import Base from '../layouts/Base.astro';
import { TEL, BOOKING } from '../site.js';

// 내용은 옛 사이트 납골당(ossuary) 페이지 원문에서 옮김. 금액은 1년 약정, 부가세 별도
const tiers = [
  ['1단', '250,000', '200,000'],
  ['2·3·6단', '350,000', '250,000'],
  ['4·5단', '550,000', '350,000'],
  ['가족당 2칸', '650,000', '450,000'],
  ['가족당 3칸', '850,000', '650,000'],
];

const heroPhotos = [
  ['house.jpg', '밝은 흰색 안치단이 늘어선 헤븐 하우스 내부'],
  ['house-lounge.jpg', '소파와 안락의자가 놓인 가족 대기 라운지'],
  ['house-hall.jpg', '안치실로 이어지는 복도'],
];

// 보내주신 사진 6장 중 다섯은 기존 사진과 같은 원본(갤러리 3장·히어로 2장)이라 새로 넣은 건 house-4 하나. 라운지·전경은 히어로에도 있지만 갤러리에서도 보이게
const photos = [
  ['house-1.jpg', '흰색 안치단이 벽면을 채운 헤븐 하우스'],
  ['house-2.jpg', '안치단 사이로 이어지는 헤븐 하우스 복도'],
  ['house-3.jpg', '가족이 머무를 수 있는 원목 테이블이 놓인 헤븐 하우스'],
  ['house-4.jpg', '안치단 벽과 가족 테이블이 함께 보이는 헤븐 하우스'],
  ['house.jpg', '밝은 흰색 안치단이 늘어선 헤븐 하우스 전경'],
  ['house-lounge.jpg', '소파와 안락의자가 놓인 가족 대기 라운지'],
];
---
<Base title="헤븐 하우스 | 아이헤븐" description="언제든 만날 수 있는 반려동물 안식처, 아이헤븐 납골당 헤븐 하우스. 오전 9시부터 오후 6시까지 연중무휴 방문, 1년 약정 200,000원부터.">
  <section class="section intro">
    <div class="intro-inner">
      <div class="intro-copy">
        <p class="badge">아이헤븐 납골당</p>
        <h1>언제든 만날 수 있는 안식처, <br />헤븐 하우스</h1>
        <p>아이헤븐은 추억과 기억의 공간입니다. 사랑했던 반려동물과 함께한 순간들을 기억하고, 아름다운 추억과 행복했던 순간들이 되살아나는 공간을 마련하였습니다.</p>
        <p>언제나 쾌적한 공간과 안락한 분위기로, 당신의 반려동물이 편히 쉴 수 있는 안식처가 될 것입니다.</p>
        <div class="intro-cta">
          <a class="btn btn--gold" href={`tel:${TEL}`}>안치 상담 {TEL}</a>
          <a class="intro-link" href="#price">비용 보기</a>
        </div>
      </div>
      <!-- 슬라이더 동작은 Base.astro. 자동 5초 넘김, 드래그·스와이프 -->
      <div class="intro-media">
        <div class="intro-photo">
          {heroPhotos.map(([src, alt], i) => <img src={`images/${src}`} alt={alt} draggable="false" loading={i ? 'lazy' : 'eager'} />)}
        </div>
      </div>
      <a class="hero-scroll" href="#visit" aria-label="아래로 스크롤"><span>SCROLL</span><i aria-hidden="true"></i></a>
    </div>
  </section>

  <section class="section" id="visit">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">방문 안내</p>
        <h2>소중했던 아이가 머무를 수 있는 곳</h2>
        <p>헤븐 하우스 방문은 오전 9시부터 오후 6시까지 연중무휴로 가능하며, 그 외 시간에는 문의하신 후 방문하실 수 있습니다.</p>
      </div>
      <ul class="swipe gallery">
        {photos.map(([src, alt]) => <li><img src={`images/${src}`} alt={alt} loading="lazy" /></li>)}
      </ul>
      <p class="note">자택 또는 다른 곳에 안치 중인 봉안함도 아이헤븐에서 이함하신 후 납골당에 안치하실 수 있습니다.</p>
    </div>
  </section>

  <section class="section soft" id="price">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">봉안당 비용</p>
        <h2>1년 약정 기준 안치 비용</h2>
        <p>중앙 열과 측면 열, 단 높이에 따라 비용이 다릅니다. 가족당은 두 칸 또는 세 칸을 이어 함께 모시는 자리입니다.</p>
      </div>
      <table class="tiers">
        <thead><tr><th>구분</th><th>중앙</th><th>측면</th></tr></thead>
        <tbody>
          {tiers.map(([name, center, side]) => (
            <tr><th scope="row">{name}</th><td>{center}<span>원</span></td><td>{side}<span>원</span></td></tr>
          ))}
        </tbody>
      </table>
      <p class="note">모든 금액은 1년 약정 기준이며 부가세 별도입니다. 헤븐 최고급 장례에는 헤븐 하우스 안치가 포함되어 있습니다.</p>
    </div>
  </section>

  <section class="section intro closing">
    <div class="wrap closing-inner">
      <h2>단지 모습만 다를 뿐, 가족입니다</h2>
      <p>헤븐 하우스 안치와 장례 예약은 24시간 상담해 드립니다.</p>
      <div class="intro-cta">
        <a class="btn btn--gold" href={`tel:${TEL}`}>24시 상담 {TEL}</a>
        <a class="btn btn--light" href={BOOKING} target="_blank" rel="noopener">예약하기</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* 인트로 공통 꼴·슬라이더는 Base.astro. 여기선 메인 카드와 잇는 전환 이름만 */
  .intro-photo { view-transition-name: house-photo; }

  .gallery { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  /* 데스크톱은 3열 2줄이라 16:9 로 낮춰 한 화면에. 모바일은 한 장씩 크게 4:3 */
  .gallery img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  #visit .section-head { margin-bottom: 40px; }

  .tiers { width: min(720px, 100%); margin-inline: auto; border-collapse: collapse; background: #fff; border: 1px solid var(--line); }
  /* 모든 칸 한 줄. 머리글은 가운데, 금액은 오른쪽 정렬로 자릿수를 맞춤 */
  .tiers th, .tiers td { padding: 18px 24px; text-align: left; border-top: 1px solid var(--line); white-space: nowrap; }
  .tiers thead th { text-align: center; }
  .tiers td { text-align: right; }
  .tiers thead th { border-top: 0; background: var(--brand-deep); color: #fff; font-weight: 500; font-size: 15px; }
  .tiers tbody th { font-weight: 500; color: var(--ink); }
  .tiers td { font-size: 22px; font-weight: 700; color: var(--gold-deep); font-variant-numeric: tabular-nums; }
  .tiers td span { font-size: 14px; font-weight: 400; color: var(--muted); margin-left: 3px; }

  @media (max-width: 860px) {
    .gallery { grid-template-columns: 1fr; }
    .gallery img { aspect-ratio: 4 / 3; }
    .tiers th, .tiers td { padding: 12px 14px; }
    .tiers td { font-size: 17px; }
  }
  /* 낮은 화면에선 설명 문장을 접어 표까지, 갤러리 안내문을 접어 사진까지 한 화면에 */
  @media (max-width: 860px) and (max-height: 700px) {
    #price .section-head p, #visit .note { display: none; }
  }
  /* 320px 급 작은 화면에서 표가 화면을 넘지 않게 */
  @media (max-width: 360px) {
    .tiers th, .tiers td { padding: 12px 10px; }
    .tiers td { font-size: 16px; }
  }
</style>
