---
import { TEL, BOOKING, ADDRESS } from '../site.js';
const { title = '아이헤븐 | 김해 반려동물 장례식장', description = '1:1 담당 장례지도사, 100% 예약제, 개별화장과 보호자 참관. 진실된 책임장례만을 약속하는 김해 반려동물 장례식장 아이헤븐입니다.' } = Astro.props;
// 공유 미리보기는 절대 URL만 인식. Astro.url 은 site+base 기준
const ogImage = new URL('og.png', Astro.url);
// build.format 'file' 이라 메인이 index.html 로 잡힘. 대표 주소는 폴더 주소로
const pageUrl = String(Astro.url).replace(/index\.html$/, '');
const current = (name) => new RegExp(`/${name}(\\.html)?$`).test(Astro.url.pathname) ? 'page' : undefined;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="아이헤븐" />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="아이헤븐 김해 반려동물 장례식장, 24시 장례상담 1577-5474" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={pageUrl} />
  <!-- 옛 사이트(iheaven.kr) 심볼 그대로, 건물 간판과 일치 -->
  <link rel="icon" href="favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500;600;700&display=swap" />
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="./" class="brand" aria-label="아이헤븐 홈">
        <img src="logo.svg" alt="" width="120" height="27" />
      </a>
      <nav id="nav" class="nav" aria-label="주요 메뉴" onclick="if (event.target.closest('a')) { this.parentNode.parentNode.classList.remove('is-open'); document.querySelector('.nav-toggle').setAttribute('aria-expanded', 'false') }">
        <a href="service.html" aria-current={current('service')}>장례서비스</a>
        <a href="./#price">장례비용</a>
        <a href="lucete.html" aria-current={current('lucete')}>루세떼</a>
        <a href="house.html" aria-current={current('house')}>헤븐 하우스</a>
        <a href="./#location">오시는 길</a>
      </nav>
      <div class="header-actions">
        <a class="header-cta" href={`tel:${TEL}`}>24시 장례상담 <strong>{TEL}</strong></a>
        <a class="btn header-book" href={BOOKING} target="_blank" rel="noopener">예약하기</a>
        <button class="nav-toggle" aria-label="메뉴" aria-expanded="false" aria-controls="nav" onclick="this.setAttribute('aria-expanded', this.closest('.site-header').classList.toggle('is-open'))">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
        </button>
      </div>
    </div>
  </header>

  <main><slot /></main>
  <script>
    // 상세페이지 히어로 슬라이더: 마우스 드래그로 넘기기 + 5초 자동 넘김. 손대면 8초 쉼. 터치 스와이프는 브라우저 기본 스크롤
    const slider = document.querySelector<HTMLElement>('.intro-photo');
    if (slider && slider.children.length > 1) {
      let pausedUntil = 0, dragging = false, startX = 0, startLeft = 0;
      const snap = () => { const w = slider.clientWidth; slider.scrollTo({ left: Math.round(slider.scrollLeft / w) * w, behavior: 'smooth' }); };
      slider.addEventListener('pointerdown', (e) => {
        pausedUntil = Date.now() + 8000;
        if (e.pointerType !== 'mouse') return;
        dragging = true; startX = e.clientX; startLeft = slider.scrollLeft;
        slider.classList.add('is-dragging'); slider.setPointerCapture(e.pointerId);
      });
      slider.addEventListener('pointermove', (e) => { if (dragging) slider.scrollLeft = startLeft - (e.clientX - startX); });
      const release = () => { if (!dragging) return; dragging = false; slider.classList.remove('is-dragging'); snap(); };
      slider.addEventListener('pointerup', release);
      slider.addEventListener('pointercancel', release);
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        setInterval(() => {
          if (dragging || document.hidden || Date.now() < pausedUntil) return;
          const w = slider.clientWidth;
          const atEnd = slider.scrollLeft + w >= slider.scrollWidth - 2;
          slider.scrollTo({ left: atEnd ? 0 : slider.scrollLeft + w, behavior: 'smooth' });
        }, 5000);
      }
    }
  </script>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-top">
        <p class="brand brand--footer"><img src="logo.svg" alt="아이헤븐" width="108" height="24" /></p>
        <p class="footer-contact">
          <span>24시 장례상담 <a href={`tel:${TEL}`}>{TEL}</a></span>
          <span>이메일 <a href="mailto:iheaven_official@naver.com">iheaven_official@naver.com</a></span>
          <span>주소 <span class="footer-value">{ADDRESS}</span></span>
        </p>
      </div>
      <dl class="biz">
        <div><dt>상호</dt><dd>주식회사 아이헤븐</dd></div>
        <div><dt>대표</dt><dd>임채윤</dd></div>
        <div><dt>사업자등록번호</dt><dd>757-88-03042</dd></div>
        <div><dt>동물장묘업 허가번호</dt><dd>제 5350000-038-2018-0001호 <a class="biz-link" href="license.jpg" target="_blank" rel="noopener" onclick="event.preventDefault(); document.getElementById('license').showModal()">허가증 보기</a></dd></div>
      </dl>
      <p class="footer-links"><a href="privacy.html">개인정보 처리방침</a></p>
      <p class="copy">© 아이헤븐. All rights reserved.</p>
    </div>
  </footer>

  <dialog id="license" class="license" aria-label="동물장묘업 허가증" onclick="if (event.target === this) this.close()">
    <form method="dialog"><button class="license-close" aria-label="닫기">×</button></form>
    <img src="license.jpg" alt="동물장묘업 허가증 (주식회사 아이헤븐, 제 5350000-038-2018-0001호)" width="524" height="720" loading="lazy" />
  </dialog>

  <nav class="mobile-bar" aria-label="빠른 상담">
    <a href={`tel:${TEL}`} class="is-primary">전화 상담</a>
    <a href={BOOKING} target="_blank" rel="noopener">예약하기</a>
  </nav>
</body>
</html>

<style is:global>
  :root {
    --brand: #333;
    --gold: #bca280;
    --gold-deep: #a58b6a;
    --gold-light: #ddbf97;
    --brand-deep: #222;
    --ink: #222;
    --text: #4a4a4a;
    --muted: #77736e;
    --line: #e8e4de;
    --soft: #f7f5f2;
    --radius: 16px;
    --serif: 'Noto Serif KR', 'AppleMyungjo', 'Batang', serif;
  }
  * { box-sizing: border-box; }
  /* 모바일에서 링크·버튼을 누를 때 생기는 회색 깜빡임을 사이트 전체에서 끔 (상속돼서 새 링크에도 적용) */
  html { -webkit-tap-highlight-color: transparent; }
  /* 페이지 사이 이동을 브라우저 기본 전환으로. 헤더·하단 바는 그대로 두고 본문만 바뀜. 지원 안 하는 브라우저는 그냥 이동 */
  @media (prefers-reduced-motion: no-preference) {
    @view-transition { navigation: auto; }
  }
  .site-header { view-transition-name: site-header; }
  .mobile-bar { view-transition-name: mobile-bar; }
  /* 배포본(n-utti.github.io/iheaven)과 같은 느린 페이드. 헤더 버튼 이동도 같은 전환을 탐 */
  ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation-duration: .8s; animation-timing-function: ease-in-out; }
  html { scroll-behavior: smooth; scroll-padding-top: 84px; }
  body { margin: 0; background: #fff; color: var(--text); font: 400 16px/1.75 var(--serif); word-break: keep-all; -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; transition: color .2s, opacity .2s, border-color .2s; }
  h1, h2, h3 { color: var(--ink); line-height: 1.35; margin: 0; font-weight: 700; text-wrap: balance; }
  p { margin: 0; }
  img { display: block; }
  .wrap { width: min(1180px, 100% - 40px); margin-inline: auto; }

  .brand { display: flex; align-items: center; gap: 10px; color: var(--brand); }

  /* 애플식 글래스: 반투명 + 블러·채도 올림 + 얇은 하이라이트 선. 블러 미지원 브라우저는 불투명 흰색으로 */
  .site-header { position: sticky; top: 0; z-index: 30; background: #fff; border-bottom: 1px solid rgba(0,0,0,.08); box-shadow: inset 0 1px 0 rgba(255,255,255,.6); }
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .site-header { background: rgba(255,255,255,.62); -webkit-backdrop-filter: saturate(180%) blur(20px); backdrop-filter: saturate(180%) blur(20px); }
  }
  /* 메인 맨 위(히어로 위)에선 투명 + 흰 글씨. index.astro 가 스크롤 위치로 is-top 을 토글. 모바일 메뉴가 열리면 해제 */
  .site-header { transition: background .3s, box-shadow .3s, border-color .3s; }
  .site-header.is-top:not(.is-open) { background: transparent; -webkit-backdrop-filter: none; backdrop-filter: none; box-shadow: none; border-bottom-color: transparent; }
  .site-header.is-top:not(.is-open) :is(.nav a, .header-cta, .header-cta strong, .nav-toggle) { color: #fff; }
  .site-header.is-top:not(.is-open) .brand img { filter: brightness(0) invert(1); }
  .header-inner { --pad: clamp(20px, 3vw, 44px); display: flex; align-items: center; justify-content: space-between; gap: 0 32px; height: 84px; padding-inline: var(--pad); }
  .nav { display: flex; gap: clamp(25px, 2.4vw + 5px, 45px); font-size: 16px; font-weight: 500; color: var(--ink); }
  .nav a:hover, .nav a[aria-current] { color: var(--gold-deep); text-decoration: underline; text-underline-offset: 8px; }
  .nav a[aria-current] { font-weight: 700; }
  .header-actions { display: flex; align-items: center; gap: 25px; }
  .header-cta { font-size: 14px; color: var(--muted); }
  .header-cta strong { display: block; font-size: 20px; color: var(--gold-deep); line-height: 1.2; transition: color .2s; }
  .header-cta:hover, .header-cta:hover strong { color: var(--ink); }
  .nav-toggle { display: none; padding: 10px; margin-right: -10px; border: 0; background: none; color: var(--ink); cursor: pointer; transition: color .2s; }
  .nav-toggle:hover { color: var(--gold-deep); }

  .btn { display: inline-flex; align-items: center; justify-content: center; height: 44px; padding: 0 22px; border-radius: 4px; font-weight: 600; font-size: 15px; background: var(--brand); color: #fff; transition: background .2s; }
  .btn:hover { background: var(--brand-deep); }
  .btn--line { background: transparent; color: var(--brand); box-shadow: inset 0 0 0 1px var(--brand); }
  .btn--line:hover { background: var(--brand); color: #fff; }
  .btn--light { background: #fff; color: var(--brand); }
  .btn--light:hover { background: var(--soft); }

  /* 글 속 링크 */
  .text-link { color: var(--gold-deep); text-decoration: underline; text-underline-offset: 3px; transition: color .2s, text-underline-offset .2s; }
  .text-link:hover { color: var(--ink); text-underline-offset: 5px; }

  .section { padding-block: 120px; }
  .section-head { display: grid; gap: 12px; margin-bottom: 56px; text-align: center; justify-items: center; }
  .section-head h2 { font-size: clamp(26px, 3vw, 36px); }
  .section-head p { color: var(--muted); max-width: 640px; text-wrap: pretty; }
  .eyebrow { font-size: 15px; color: var(--muted); }

  /* 비용 카드. 메인 장례비용과 루세떼 비용이 같이 씀 */
  .plan-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .plan { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 36px 32px; display: grid; gap: 14px; align-content: start; }
  .plan--featured { border: 2px solid var(--gold); }
  .plan h3 { font-size: 19px; }
  .plan-price { color: var(--muted); }
  .plan-price strong { font-size: 34px; font-weight: 700; color: var(--gold-deep); margin-right: 4px; }
  .plan ul { list-style: none; margin: 0; padding: 18px 0 0; border-top: 1px solid var(--line); display: grid; gap: 8px; font-size: 15px; }
  .plan li::before { content: '✓'; color: var(--gold-deep); margin-right: 10px; font-weight: 700; }

  /* 상세페이지 공통: 인트로(사진이 오른쪽·위·아래 화면 끝에 붙는 꼴, 왼쪽 글은 .wrap 왼쪽 선)·마무리 CTA. 사진 크로스페이드 keyframes 는 장 수가 달라 각 페이지에 */
  .intro { background: var(--brand-deep); color: #bdb7af; }
  .intro h1, .intro h2 { color: #fff; }
  .intro:has(.intro-inner) { padding-block: 0; }
  .intro-inner { display: grid; grid-template-columns: minmax(20px, 1fr) minmax(0, 570px) minmax(0, 570px) minmax(0, 1fr); align-items: center; min-height: calc(100svh - 84px); }
  .intro-copy { grid-column: 2; display: grid; gap: 20px; padding-block: 120px; padding-right: clamp(40px, 6vw, 88px); }
  .intro h1 { font-size: clamp(32px, 4.2vw, 52px); }
  /* 사진 슬라이더: 가로 스크롤 스냅. 터치는 그대로 스와이프, 마우스 드래그와 5초 자동 넘김은 아래 script */
  /* contain: size 로 사진 원본 높이가 틀을 키우지 못하게. 높이는 데스크톱 = 글 쪽 행 높이, 모바일 = 3:2 비율 */
  .intro-photo { grid-column: 3 / -1; align-self: stretch; min-height: 520px; contain: size; display: flex; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; scrollbar-width: none; cursor: grab; }
  .intro-photo::-webkit-scrollbar { display: none; }
  .intro-photo.is-dragging { cursor: grabbing; scroll-snap-type: none; }
  .intro-photo img { flex: 0 0 100%; width: 100%; height: 100%; object-fit: cover; scroll-snap-align: start; user-select: none; -webkit-user-drag: none; }
  .intro-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; margin-top: 12px; }
  .intro-link { color: var(--gold-light); border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  .intro-link:hover { color: #fff; }
  /* 들어올 때 글이 차례로 떠오름 */
  @media (prefers-reduced-motion: no-preference) {
    .intro-copy > * { animation: rise 1.6s ease-out both; }
    .intro-copy > :nth-child(2) { animation-delay: .25s; }
    .intro-copy > :nth-child(3) { animation-delay: .5s; }
    .intro-copy > :nth-child(4) { animation-delay: .75s; }
    .intro-copy > :nth-child(5) { animation-delay: 1s; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } }
  /* 강조 아님. 연한 작은 글씨로 제목에 바짝 붙임 */
  .badge { font-size: 14px; color: #8f8a83; margin-bottom: -8px; }
  .btn--gold { background: var(--gold); color: var(--ink); }
  .btn--gold:hover { background: var(--gold-light); }
  .soft { background: var(--soft); }
  .note { margin-top: 28px; text-align: center; font-size: 15px; color: var(--muted); }
  .closing-inner { display: grid; gap: 16px; justify-items: center; text-align: center; }
  .closing h2 { font-size: clamp(24px, 2.8vw, 34px); }

  .site-footer { background: var(--brand-deep); color: #aaa; padding: 64px 0 56px; font-size: 14px; }
  .footer-top { display: flex; flex-direction: column; gap: 16px; padding-bottom: 28px; border-bottom: 1px solid #3a3a3a; }
  .footer-contact { display: flex; flex-wrap: wrap; gap: 6px 28px; margin: 0; color: #777; }
  .footer-contact a, .footer-value { margin-left: 8px; color: #ddd; }
  .footer-contact a:hover { color: #fff; }
  .brand--footer { color: #fff; }
  .brand--footer img { filter: brightness(0) invert(1); }
  .biz { display: flex; flex-wrap: wrap; gap: 6px 28px; margin: 28px 0 20px; }
  .biz div { display: flex; gap: 8px; }
  .biz dt { color: #777; }
  .biz dd { margin: 0; }
  .biz-link { margin-left: 6px; text-decoration: underline; text-underline-offset: 3px; }
  .biz-link:hover { color: #fff; }
  .license { padding: 0; border: 0; border-radius: 8px; overflow: visible; background: #fff; }
  .license::backdrop { background: rgba(0,0,0,.7); }
  .license img { width: auto; max-width: 90vw; max-height: 86vh; height: auto; }
  .license-close { position: absolute; top: -44px; right: 0; width: 36px; height: 36px; border: 0; background: none; color: #fff; font-size: 34px; line-height: 1; cursor: pointer; transition: opacity .2s; }
  .license-close:hover { opacity: .65; }
  .footer-links { margin-bottom: 8px; }
  .footer-links a { color: #fff; font-weight: 700; }
  .footer-links a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .copy { color: #777; font-size: 13px; }

  .mobile-bar { display: none; }

  @media (max-width: 1080px) {
    html { scroll-padding-top: 132px; }
    /* 메뉴를 숨기지 않고 헤더 아래 가로 스크롤 줄로 */
    .header-inner { flex-wrap: wrap; height: auto; }
    .brand, .header-actions { height: 84px; }
    .nav { order: 3; flex: 0 0 auto; width: calc(100% + 2 * var(--pad)); margin-inline: calc(-1 * var(--pad)); padding-inline: var(--pad) 48px; gap: 24px; overflow-x: auto; white-space: nowrap; font-size: 15px; border-top: 1px solid var(--line); scrollbar-width: none; }
    /* 잘린 메뉴가 있다는 신호: 오른쪽 끝을 흐리게, 끝까지 밀면 마지막 항목은 패딩 덕에 선명 */
    .nav { -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent); mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent); }
    .nav::-webkit-scrollbar { display: none; }
    .nav a { padding-block: 10px; }
  }
  @media (max-width: 860px) {
    html { scroll-padding-top: 60px; }
    /* 모바일 사진 줄: 격자 대신 한 장씩 크게 보는 가로 스와이프. .wrap 여백까지 끌어와 화면 끝에서 끝으로, 다음 장이 살짝 보이게.
       선택자를 세 번 겹친 건 각 페이지의 scoped 격자 규칙(특이도 0,2,0)보다 앞서기 위함 */
    .swipe.swipe.swipe { display: grid; grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 84%; gap: 14px; width: auto; margin-inline: -20px; padding-inline: 20px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 20px; scrollbar-width: none; }
    .swipe::-webkit-scrollbar { display: none; }
    .swipe > * { scroll-snap-align: start; }
    .intro-inner { grid-template-columns: 1fr; gap: 0; grid-template-rows: 1fr auto; min-height: calc(100svh - 60px - 58px - env(safe-area-inset-bottom)); }
    .intro h1 br { display: none; }
    .intro-copy { grid-column: 1; padding: 20px 20px 48px; }
    .intro-photo { grid-column: 1; order: -1; min-height: 0; height: auto; aspect-ratio: 3 / 2; }
    html { scroll-padding-top: 60px; }
    .brand, .header-actions { height: 60px; }
    /* 하단 고정 바의 전화 상담과 중복이라 그 자리에 햄버거 */
    .header-cta { display: none; }
    .nav-toggle { display: block; }
