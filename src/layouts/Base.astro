---
import { TEL, BOOKING, ADDRESS } from '../site.js';
const { title = '아이헤븐 | 김해 반려동물 장례식장', description = '1:1 담당 장례지도사, 100% 예약제, 개별화장과 보호자 참관. 진실된 책임장례만을 약속하는 김해 반려동물 장례식장 아이헤븐입니다.' } = Astro.props;
// 공유 미리보기는 절대 URL만 인식 — Astro.url 은 site+base 기준
const ogImage = new URL('og.png', Astro.url);
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="아이헤븐" />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="아이헤븐 김해 반려동물 장례식장, 24시 장례상담 1577-5474" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={Astro.url} />
  <!-- 옛 사이트(iheaven.kr) 심볼 그대로 — 건물 간판과 일치 -->
  <link rel="icon" href="favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;500;600;700&family=Noto+Serif+KR:wght@600;700&display=swap" />
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="./" class="brand" aria-label="아이헤븐 홈">
        <img src="logo.png" alt="" width="148" height="40" />
      </a>
      <nav class="nav" aria-label="주요 메뉴">
        <a href="#service">장례서비스</a>
        <a href="#price">장례비용</a>
        <a href="#lucete">루세떼</a>
        <a href="#house">납골당</a>
        <a href="#aftercare">사후 수습 방법</a>
        <a href="#location">오시는 길</a>
      </nav>
      <div class="header-actions">
        <a class="header-cta" href={`tel:${TEL}`}>24시 장례상담 <strong>{TEL}</strong></a>
        <a class="btn header-book" href={BOOKING} target="_blank" rel="noopener">예약하기</a>
      </div>
    </div>
  </header>

  <main><slot /></main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-top">
        <p class="brand brand--footer"><img src="logo.png" alt="아이헤븐" width="133" height="36" /></p>
      </div>
      <dl class="biz">
        <div><dt>상호</dt><dd>주식회사 아이헤븐</dd></div>
        <div><dt>대표</dt><dd>임채윤</dd></div>
        <div><dt>사업자등록번호</dt><dd>757-88-03042</dd></div>
        <div><dt>동물장묘업 허가번호</dt><dd>제 5350000-038-2018-0001호 <a class="biz-link" href="license.jpg" target="_blank" rel="noopener" onclick="event.preventDefault(); document.getElementById('license').showModal()">허가증 보기</a></dd></div>
        <div><dt>통신판매업 신고번호</dt><dd>제 2018-경남김해-0585호</dd></div>
        <div><dt>주소</dt><dd>{ADDRESS}</dd></div>
        <div><dt>24시 장례상담</dt><dd>{TEL}</dd></div>
        <div><dt>이메일</dt><dd>iheaven_official@naver.com</dd></div>
      </dl>
      <p class="copy">© 아이헤븐. All rights reserved.</p>
    </div>
  </footer>

  <dialog id="license" class="license" aria-label="동물장묘업 허가증" onclick="if (event.target === this) this.close()">
    <form method="dialog"><button class="license-close" aria-label="닫기">×</button></form>
    <img src="license.jpg" alt="동물장묘업 허가증 (주식회사 아이헤븐, 제 5350000-038-2018-0001호)" width="524" height="720" loading="lazy" />
  </dialog>

  <nav class="mobile-bar" aria-label="빠른 상담">
    <a href={`tel:${TEL}`} class="is-primary">전화 상담</a>
    <a href={BOOKING} target="_blank" rel="noopener">예약하기</a>
  </nav>
</body>
</html>

<style is:global>
  :root {
    --brand: #333;
    --gold: #bca280;
    --gold-deep: #a58b6a;
    --gold-light: #ddbf97;
    --brand-deep: #222;
    --ink: #222;
    --text: #4a4a4a;
    --muted: #77736e;
    --line: #e8e4de;
    --soft: #f7f5f2;
    --radius: 16px;
    --sans: 'IBM Plex Sans KR', -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif;
    --serif: 'Noto Serif KR', 'AppleMyungjo', 'Batang', serif;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 84px; }
  body { margin: 0; background: #fff; color: var(--text); font: 400 16px/1.75 var(--sans); word-break: keep-all; -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  h1, h2, h3 { color: var(--ink); line-height: 1.35; margin: 0; font-weight: 700; }
  /* 큰 제목만 명조 — 추모 톤. 작은 h3는 고딕 유지(가독성) */
  h1, h2 { font-family: var(--serif); }
  p { margin: 0; }
  img { display: block; }
  .wrap { width: min(1180px, 100% - 40px); margin-inline: auto; }

  .brand { display: flex; align-items: center; gap: 10px; color: var(--brand); }

  .site-header { position: sticky; top: 0; z-index: 30; background: rgba(255,255,255,.94); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 32px; height: 84px; padding-inline: clamp(20px, 3vw, 44px); }
  .nav { display: flex; gap: clamp(20px, 2.4vw, 40px); font-size: 16px; font-weight: 500; color: var(--ink); }
  .nav a:hover { color: var(--gold-deep); text-decoration: underline; text-underline-offset: 8px; }
  .header-actions { display: flex; align-items: center; gap: 20px; }
  .header-cta { font-size: 14px; color: var(--muted); }
  .header-cta strong { display: block; font-size: 20px; color: var(--gold-deep); line-height: 1.2; }

  .btn { display: inline-flex; align-items: center; justify-content: center; height: 44px; padding: 0 22px; border-radius: 4px; font-weight: 600; font-size: 15px; background: var(--brand); color: #fff; transition: background .2s; }
  .btn:hover { background: var(--brand-deep); }
  .btn--line { background: transparent; color: var(--brand); box-shadow: inset 0 0 0 1px var(--brand); }
  .btn--line:hover { background: var(--brand); color: #fff; }
  .btn--light { background: #fff; color: var(--brand); }
  .btn--light:hover { background: var(--soft); }

  .section { padding-block: 120px; }
  .section-head { display: grid; gap: 12px; margin-bottom: 56px; text-align: center; justify-items: center; }
  .section-head h2 { font-size: clamp(26px, 3vw, 36px); }
  .section-head p { color: var(--muted); max-width: 640px; }
  .eyebrow { font-size: 15px; color: var(--muted); }

  /* ponytail: 사진 저작권 확인 전까지 쓰는 목업 칸. 실사진 받으면 <img>로 교체 */
  .ph { position: relative; display: grid; place-items: center; border-radius: var(--radius); overflow: hidden; color: #8f8a83; font-size: 14px; text-align: center; padding: 16px;
    background: repeating-linear-gradient(135deg, #efece7 0 14px, #e9e5df 14px 28px); }
  .ph::before { content: 'PHOTO'; position: absolute; top: 14px; left: 16px; font-size: 11px; letter-spacing: .2em; opacity: .7; }

  .site-footer { background: var(--brand-deep); color: #aaa; padding: 64px 0 56px; font-size: 14px; }
  .footer-top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px; padding-bottom: 28px; border-bottom: 1px solid #3a3a3a; }
  .brand--footer { color: #fff; }
  .brand--footer img { filter: brightness(0) invert(1); }
  .biz { display: flex; flex-wrap: wrap; gap: 6px 28px; margin: 28px 0 20px; }
  .biz div { display: flex; gap: 8px; }
  .biz dt { color: #777; }
  .biz dd { margin: 0; }
  .biz-link { margin-left: 6px; text-decoration: underline; text-underline-offset: 3px; }
  .biz-link:hover { color: #fff; }
  .license { padding: 0; border: 0; border-radius: 8px; overflow: visible; background: #fff; }
  .license::backdrop { background: rgba(0,0,0,.7); }
  .license img { width: auto; max-width: 90vw; max-height: 86vh; height: auto; }
  .license-close { position: absolute; top: -44px; right: 0; width: 36px; height: 36px; border: 0; background: none; color: #fff; font-size: 34px; line-height: 1; cursor: pointer; }
  .copy { color: #777; font-size: 13px; }

  .mobile-bar { display: none; }

  @media (max-width: 1080px) {
    .nav { display: none; }
  }
  @media (max-width: 860px) {
    .header-inner { height: 64px; }
    .header-cta { font-size: 0; }
    .header-cta strong { font-size: 16px; }
    .section { padding-block: 80px; }
    .header-book { display: none; }
    .site-footer { padding-bottom: 110px; }
    .mobile-bar { display: grid; grid-template-columns: repeat(2, 1fr); position: fixed; inset: auto 0 0; z-index: 30; background: #fff; border-top: 1px solid var(--line); padding-bottom: env(safe-area-inset-bottom); }
    .mobile-bar a { text-align: center; padding: 16px 0; font-weight: 600; font-size: 15px; color: var(--brand); }
    .mobile-bar .is-primary { background: var(--brand); color: #fff; }
  }
</style>
